# Read by Netlify and Cloudflare Pages. The service worker and entry page must never be
# cached stale, or testers keep running an old version; hashed assets can cache forever.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
