{
  "name": "kasa-pos",
  "productName": "Kasa POS",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, cross-platform point of sale for retail, restaurants and services. Web, Windows, macOS, Linux, Android and iOS from one codebase.",
  "author": "Kasa POS",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/smoke.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "server": "node server/src/index.js",
    "server:dev": "node --watch server/src/index.js",
    "desktop": "npm run build && electron .",
    "desktop:dev": "cross-env ELECTRON_DEV_URL=http://localhost:5173 electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "mobile:sync": "npm run build && cap sync",
    "android": "npm run mobile:sync && cap open android",
    "ios": "npm run mobile:sync && cap open ios",
    "github:setup": "bash scripts/github-setup.sh",
    "sync:watch": "bash scripts/auto-sync.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "barcode-detector": "^3.2.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "zustand": "^5.0.15",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  },
  "repository": "github:imbikramsaha/kasa-pos"
}
