{
  "name": "openpos-server",
  "version": "1.0.0",
  "private": true,
  "description": "OpenPOS sync server: multi-store last-write-wins replication for offline-first tills, backed by SQLite. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js"
  },
  "bin": {
    "openpos-server": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "create-store": "node src/index.js create-store",
    "list-stores": "node src/index.js list-stores"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
